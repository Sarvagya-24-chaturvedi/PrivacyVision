{
  "manifest_version": 3,
  "name": "PrivacyVision — On-Device Visual Browser Agent",
  "version": "2.0.0",
  "description": "On-device visual perception with real face detection, universal page coverage (Google Forms, PDFs, SPAs), and trained MobileViT ONNX agent.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "models/*.onnx",
        "models/tessdata/*",
        "offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
